<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
    <name>car_tracker</name>
    <version>0.1.0</version>
    <description>
        Top-level bringup for the car-tracker stack on a MentorPi M1. Holds the launch tree
        and shared configuration; contains no nodes of its own. robot.launch.py brings up the
        Pi, desktop.launch.py brings up the desktop.
    </description>
    <maintainer email="aboccacc@umich.edu">redto0</maintainer>
    <license>MIT</license>

    <buildtool_depend>ament_cmake</buildtool_depend>

    <!--Launch-only package: everything below is needed at runtime, not to build.-->
    <exec_depend>launch</exec_depend>
    <exec_depend>launch_ros</exec_depend>

    <!--Camera pipeline-->
    <exec_depend>image_proc</exec_depend>
    <exec_depend>image_transport</exec_depend>
    <exec_depend>image_transport_plugins</exec_depend>

    <!--Teleop. Referenced only by teleop.launch.py, so nothing else pulls them in.-->
    <exec_depend>joy</exec_depend>
    <exec_depend>teleop_twist_joy</exec_depend>

    <!--Vendor driver layer, from car_tracker.repos.-->
    <exec_depend>controller</exec_depend>
    <exec_depend>peripherals</exec_depend>
    <exec_depend>mentorpi_description</exec_depend>

    <!--laser_filters and imu_complementary_filter are used by peripherals'
        lidar.launch.py and imu_filter.launch.py, which declare no dependencies
        at all. Without these rosdep does not install them and the launch dies
        with "package not found".-->
    <exec_depend>laser_filters</exec_depend>
    <exec_depend>imu_complementary_filter</exec_depend>

    <!--rviz2 is desktop.launch.py only; rclcpp_components hosts the nav2 container.-->
    <exec_depend>rviz2</exec_depend>
    <exec_depend>rclcpp_components</exec_depend>

    <!--DDS, both machines. See dependencies.md.-->
    <exec_depend>rmw_cyclonedds_cpp</exec_depend>

    <!--System libs that slam_toolbox and nav2_map_server need but that apt only
        pulls in when THEY were installed via apt. Declared here so rosdep
        installs them regardless. See dependencies.md.-->
    <exec_depend>libceres-dev</exec_depend>
    <exec_depend>graphicsmagick</exec_depend>

    <!--Our nodes, and the vendored drivers from car_tracker.repos. These have
        no rosdep rule and never will: they are workspace packages, so rosdep
        reports them unresolvable and the ignore-src flag is what skips them.
        Declared anyway, because the dependency is real and package.xml is
        where it is looked for.-->
    <exec_depend>car_tracker_path_resolver</exec_depend>
    <exec_depend>ascamera</exec_depend>
    <exec_depend>rf2o_laser_odometry</exec_depend>

    <!--Localization, SLAM and nav, all from apt-->
    <exec_depend>robot_localization</exec_depend>
    <exec_depend>robot_state_publisher</exec_depend>
    <exec_depend>slam_toolbox</exec_depend>
    <exec_depend>nav2_bringup</exec_depend>

    <!--xacro is invoked as a command by the description launch files, so
        nothing imports it and no static check would find it. teleop_twist_keyboard
        is how the robot is driven in simulation, where there is no gamepad.-->
    <exec_depend>xacro</exec_depend>
    <exec_depend>teleop_twist_keyboard</exec_depend>

    <!--Simulation. gazebo_ros supplies spawn_entity.py and the world plugins;
        gazebo_plugins supplies the libgazebo_ros_* sensors and planar_move.
        Declared separately rather than via the gazebo_ros_pkgs metapackage so
        it is obvious which half each plugin comes from. gazebo is the
        simulator itself: normally pulled in transitively, but on this machine
        gazebo_ros was hand-placed into /opt/ros/humble outside dpkg, so apt
        never resolved its dependencies and gzserver is absent. Declare it.
        See car_tracker_design/sim_integration.md.-->
    <exec_depend>gazebo</exec_depend>
    <exec_depend>gazebo_ros</exec_depend>
    <exec_depend>gazebo_plugins</exec_depend>

    <test_depend>ament_lint_auto</test_depend>
    <test_depend>ament_cmake_xmllint</test_depend>
    <test_depend>ament_cmake_test</test_depend>
    <test_depend>python3-pytest</test_depend>

    <export>
        <build_type>ament_cmake</build_type>
    </export>
</package>
