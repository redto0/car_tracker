<?xml version="1.0"?>
<!--
  Apartment test world, 10.7 x 4.6 m. See car_tracker_design/sim_integration.md.

  Three properties are deliberate:
    * the hallway is a scan-matching degeneracy trap, where rf2o's covariance
      becomes unconstrained along the corridor axis. Exercise the weakness
      rather than design around it.
    * the living/bedroom doorway creates a CYCLE. Rooms hanging off a hallway
      form a tree, so loop closure would never fire and do_loop_closing would
      never be tested.
    * doorways are 0.85 m, narrow enough to exercise Nav2 footprint clearance
      against robot_radius 0.16.

  Carpet rectangles are VISUAL ONLY. planar_move is kinematic and ignores
  friction, so they cannot affect motion; they exist as ground truth for the
  Phase 2 fake classifier and as regions for injected odometry noise.
-->
<sdf version="1.6">
  <world name="apartment">
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <physics name="default" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <model name="wall_00">
      <static>true</static>
      <pose>5.350 0.000 0.600 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10.700 0.100 1.200</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10.700 0.100 1.200</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>
    <model name="wall_01">
      <static>true</static>
      <pose>5.350 4.600 0.600 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10.700 0.100 1.200</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10.700 0.100 1.200</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>
