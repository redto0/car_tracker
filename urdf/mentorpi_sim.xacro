<?xml version="1.0"?>
<!--
  The simulated robot: the vendor description, plus Gazebo tags.

  robot.launch.py uses mentorpi_description/urdf/mentorpi.xacro unchanged. Only
  sim.launch.py uses this one. That way the vendor fork needs no edit at all and
  the hardware description can never be contaminated by simulator concerns.
-->
<robot name="mentorpi" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find mentorpi_description)/urdf/mentorpi.xacro"/>
  <xacro:include filename="$(find car_tracker)/urdf/mentorpi.gazebo.xacro"/>
</robot>
