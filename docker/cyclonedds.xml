<?xml version="1.0" encoding="UTF-8"?>
<!--
  CycloneDDS with explicit unicast peers.

  Multicast discovery is the default and it does not survive most WiFi APs.
  They drop or mishandle it, and the symptom is nodes that simply never see
  each other, with no error logged anywhere. Listing peers explicitly
  sidesteps discovery entirely.

  PI_IP, DESKTOP_IP and CAR_TRACKER_IFACE come from the environment
  (see docker-compose.yml). Both machines need the SAME ROS_DOMAIN_ID.
-->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain id="any">
    <General>
      <!-- Pin the interface. The Pi has both wlan0 and sometimes eth0, and
           Cyclone picking the wrong one is a silent no-comms failure. -->
      <Interfaces>
        <NetworkInterface name="${CAR_TRACKER_IFACE}" priority="default" multicast="false"/>
      </Interfaces>
      <AllowMulticast>false</AllowMulticast>
    </General>
    <Discovery>
      <ParticipantIndex>auto</ParticipantIndex>
      <Peers>
        <Peer address="${PI_IP}"/>
        <Peer address="${DESKTOP_IP}"/>
      </Peers>
    </Discovery>
    <Internal>
      <!-- DO NOT set a large `min` here. It is a HARD requirement: if the kernel
           cannot grant it, Cyclone refuses to create the domain and EVERY node
           dies with "rmw_create_node: failed to create domain". Stock
           net.core.rmem_max is 212992 bytes, so a 10MB min bricks the stack.

           So `min` is omitted entirely. Note also that Cyclone rejects "KB" as a
           unit (it wants kB/KiB/MB/MiB), and a bad unit is equally fatal.

           `max` is only a request, so it is safe. To actually get the bigger
           buffer for image streaming, raise the kernel limit on the HOST (the
           container shares the host network stack):
             sudo sysctl -w net.core.rmem_max=10485760
           and persist it in /etc/sysctl.d/. -->
      <SocketReceiveBufferSize max="10MB"/>
    </Internal>
  </Domain>
</CycloneDDS>
