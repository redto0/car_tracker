# Stable device names for the MentorPi M1.
#
# INSTALL ON THE PI HOST, NOT IN THE CONTAINER. udev runs on the host; the
# container only sees the resulting nodes through the /dev bind mount.
#   sudo cp 99-car-tracker.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
#
# Why this file exists: the vendor's own rules create /dev/lidar, but
# peripherals/launch/include/ldlidar_LD19.launch.py opens /dev/ldlidar, which
# NO shipped rule creates. On the Hiwonder SD image something else supplied it.
# Without this the lidar driver cannot open its port.
#
# GROUP is dialout rather than the vendor's "ubuntu"/"users", because the
# account name differs on a self-flashed 26.04 image and dialout is standard.

# --- Controller board (ttyACM, CH9102). Motors, servos, buzzer and the IMU. ---
#
# One rule, not two. The old KERNEL=="ttyACM*" match claimed any CDC-ACM device
# on the bus -- an Arduino would have been handed /dev/rrc. And the ID_MM_PORT_IGNORE
# line carried no SUBSYSTEM anchor, so it matched the USB device rather than the
# tty and ModemManager never saw it.
#
# /dev/imu is an alias for the same node, not a second device: the IMU sits on
# this board and its samples arrive in this serial stream. See nodes/controller.md.
#
# Matched on VID/PID, not ATTRS{serial} (5917011644 on the bench board) -- a
# serial match means a replacement board silently gets no symlink.
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d4", GROUP="dialout", MODE="0660", SYMLINK+="rrc", SYMLINK+="imu", ENV{ID_MM_PORT_IGNORE}="1"

# --- LD19 lidar ---
#
# VERIFIED 2026-08-29 against the real hardware: the LD19 presents as a CH340
# USB-serial bridge, 1a86:7523, and enumerates as ttyUSB.
#
# The vendor's port-path rules (KERNELS=="1-2.3.4:1.0" / "1-2.1.4:1.0") are NOT
# used, and are not merely fragile -- they are already wrong. On the test bench
# the same lidar came up at 1-2.2:1.0, matching neither. VID/PID is stable
# across sockets and machines; the port path is not.
#
# No collision with the controller board: that is 1a86:55d4 (CH9102) on ttyACM,
# a different product id on a different subsystem.
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", GROUP="dialout", MODE="0660", SYMLINK+="ldlidar", SYMLINK+="lidar"

# --- Camera ---
#
# 2bc5 is Orbbec/Angstrong, the depth unit the ascamera driver targets.
# 3482:6723 (NOVATEK "ASJ ZNX_NVT") is the UVC camera actually on the bench:
# MJPG/YUYV, colour only, no depth stream. See car_tracker_design/nodes/camera.md.
KERNEL=="video*", ATTRS{idVendor}=="2bc5", GROUP="video", MODE="0660", SYMLINK+="depth_cam"
KERNEL=="video*", ATTRS{idVendor}=="3482", ATTRS{idProduct}=="6723", GROUP="video", MODE="0660", SYMLINK+="rgb_cam"

# --- Gamepad ---
KERNEL=="js[0-9]*", SUBSYSTEM=="input", GROUP="input", MODE="0660"
KERNEL=="event[0-9]*", SUBSYSTEM=="input", GROUP="input", MODE="0660"
