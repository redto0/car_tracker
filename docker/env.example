# Copy to the WORKSPACE ROOT as .env  (docker compose reads it from there):
#   cp src/car_tracker/docker/env.example .env
#
# Both machines must agree on ROS_DOMAIN_ID, and each needs the other's IP.
# Give the Pi a static DHCP reservation, or these go stale on every lease.

PI_IP=192.168.1.50
DESKTOP_IP=192.168.1.20

# Interface Cyclone binds to. `ip -br addr` on the Pi to check.
CAR_TRACKER_IFACE=wlan0

ROS_DOMAIN_ID=42

# Must match the Pi login, or colcon build output lands in the bind-mounted
# workspace owned by root. `id -u` / `id -g` on the Pi.
USER_UID=1000
USER_GID=1000

LIDAR_TYPE=LD19
DEPTH_CAMERA_TYPE=ascamera
