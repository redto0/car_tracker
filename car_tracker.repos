# car-tracker source dependencies -- MentorPi M1 (mecanum, Pi 5, ROS 2 Humble)
#
#   vcs import src < src/car_tracker/car_tracker.repos
#   rosdep install --from-paths src --ignore-src -r -y
#   colcon build --symlink-install
#
# Source-only. Anything available as ros-humble-* comes from apt via rosdep --
# notably slam_toolbox, navigation2 and nav2_bringup. Do not add slam_toolbox
# here: upstream's `ros2` branch is 2.10.0 and targets Jazzy, Humble ships 2.6.10.

repositories:

  # Dual-EKF localization. Upstream branches are all "-devel" suffixed; there is
  # no plain "humble" branch. Also on apt if you ever want to drop the source build.
  robot_localization:
    type: git
    url: https://github.com/cra-ros-pkg/robot_localization.git
    version: humble-devel

  # Mission manager. car_tracker's package.xml exec_depends on this, so a fresh
  # workspace needs it or robot.launch.py cannot start the mission node.
  # This is the one PRIVATE repo in this file: importing it needs an SSH key
  # authorised on it. Every other entry works over anonymous HTTPS.
  car_tracker_path_resolver:
    type: git
    url: git@github.com:redto0/car_tracker_path_resolver.git
    version: master

  # Architecture, conventions and per-node docs. Documentation only: it carries
  # no package.xml/CMakeLists.txt, so colcon walks past it and nothing needs a
  # COLCON_IGNORE. Pulled in so the docs sit beside the code they describe
  # instead of only living on GitHub. PRIVATE, same as the path resolver: this
  # is the second entry that needs an authorised SSH key.
  car_tracker_design:
    type: git
    url: git@github.com:redto0/car_tracker_design.git
    version: main

  # Hiwonder's driver layer, forked and stripped.
  #
  # The fork removes the 10 packages we do not use (yolov5_ros2 pulls torch,
  # large_models pulls LLM clients, navigation/slam duplicate our own stack),
  # flattens the tree so packages sit at the repo root, and defaults every
  # os.environ lookup so a missing variable cannot abort a launch.
  # This fork deliberately has NO main: the default branch, MentorPi-M1, is a
  # pristine mirror of Hiwonder's upstream. TODO: cut a release branch from
  # feat/driver-subset and pin that, so the pin is not a feature branch.
  MentorPiDrivers:
    type: git
    url: git@github.com:redto0/MentorPiDrivers.git
    version: feat/driver-subset

  # LD19 / STL-19P lidar driver. Referenced by peripherals/lidar.launch.py but
  # declared nowhere in Hiwonder's package.xml files, so rosdep will not find it.
  ldlidar_stl_ros2:
    type: git
    url: https://github.com/ldrobotSensorTeam/ldlidar_stl_ros2.git
    version: master

  # ROS 2 port of imu_calib. Upstream dpkoch/imu_calib is catkin-only.
  imu_calib:
    type: git
    url: https://github.com/Nathan85001/imu_calib.git
    version: ros2

  # ISC drive-mode arbitration: drive_mode_switch, inital_point_publisher.
  robot_state_controller:
    type: git
    url: git@github.com:iscumd/robot_state_controller.git
    version: ros2

  # Camera -> ground-plane projection (ray/plane intersection via image_geometry).
  camera_to_ground_projection:
    type: git
    url: git@github.com:redto0/camera_to_ground_projection.git
    version: master

  # Nav2 costmap layer for semantic segmentation. Upstream kiwicampus' "humble"
  # branch is mislabeled Jazzy-era code and does not build on Humble; our fork's
  # humble branch carries the compat fix.
  semantic_segmentation_layer:
    type: git
    url: git@github.com:redto0/semantic_segmentation_layer.git
    version: humble

# Dropped Phoenix go-kart leftovers: ackermann_msgs, twist_to_ackermann,
# teleop_ack_joy (M1 is holonomic), depthai-ros (OAK-D, wrong camera), phnx_msgs.
# logi_g29 is kept out of .repos but left in src/ deliberately.
